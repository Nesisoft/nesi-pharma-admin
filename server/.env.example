# Database
DATABASE_URL="postgresql://username:password@localhost:5432/nesi_pharma_admin?schema=public"

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this
JWT_REFRESH_EXPIRES_IN=30d

# License Key Generation
LICENSE_SECRET_KEY=your-license-generation-secret-key

# CORS - For production, set to your client URL(s)
# Supports comma-separated list for multiple origins
# Example: CORS_ORIGIN=https://your-client.vercel.app,https://custom-domain.com
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin Setup (for initial seed)
ADMIN_EMAIL=admin@nesipharma.com
ADMIN_PASSWORD=Admin@123456
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# ================================================
# VERCEL DEPLOYMENT ENVIRONMENT VARIABLES
# ================================================
# Set these in Vercel Dashboard > Project > Settings > Environment Variables
#
# SERVER (npa-server):
#   - DATABASE_URL: Your PostgreSQL connection string (e.g., from Supabase, Neon, Railway)
#   - NODE_ENV: production
#   - JWT_SECRET: A strong random secret (use: openssl rand -base64 32)
#   - JWT_REFRESH_SECRET: Another strong random secret
#   - LICENSE_SECRET_KEY: Your license generation secret
#   - CORS_ORIGIN: Your client URL (e.g., https://your-client.vercel.app)
#
# CLIENT (npa-client):
#   - VITE_API_URL: Your server URL (e.g., https://npa-server.vercel.app/api)
