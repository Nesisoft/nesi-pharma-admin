# Local development settings (copy to server/.env). Production values are set on Render:
# see render.yaml and "Hosting" in the README.

# Database
# Local: your own PostgreSQL. Production (Supabase): the Session pooler string, e.g.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://username:password@localhost:5432/nesi_pharma_admin?schema=public"

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this
JWT_REFRESH_EXPIRES_IN=30d

# License Key Generation (never change it once licence keys are issued)
LICENSE_SECRET_KEY=your-license-generation-secret-key

# CORS for the admin routes: the site's origin(s), comma-separated.
# Production: https://pharma.nesisoft.com (the site calls /api on its own domain).
CORS_ORIGIN=http://localhost:3300

# Proxies in front of the server (req.ip for rate limits and audit logs):
# 1 locally or directly on Render, 2 behind Vercel's /api rewrite. GET /api/health shows the IP seen.
TRUST_PROXY=1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# First super admin, created by the seed on a new database. Required in production
# (the defaults in prisma/seed.ts are public).
ADMIN_EMAIL=admin@nesipharma.com
ADMIN_PASSWORD=Admin@123456
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
